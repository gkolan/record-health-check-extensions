<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Named_Credential_Format</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(REGEX(NamedCredential__c, "^[A-Za-z][A-Za-z0-9_]{0,79}$"))</errorConditionFormula>
    <errorDisplayField>NamedCredential__c</errorDisplayField>
    <errorMessage>Enter a Named Credential developer name using letters, numbers, and underscores.</errorMessage>
</ValidationRule>
