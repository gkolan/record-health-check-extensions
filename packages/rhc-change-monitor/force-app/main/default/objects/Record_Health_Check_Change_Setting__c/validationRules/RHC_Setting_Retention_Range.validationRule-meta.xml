<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata"><fullName>RHC_Setting_Retention_Range</fullName><active>true</active><errorConditionFormula>OR(ISBLANK(RetentionDays__c), RetentionDays__c &lt; 1, RetentionDays__c &gt; 3650)</errorConditionFormula><errorMessage>Retention Days must be a whole number from 1 through 3650.</errorMessage></ValidationRule>
